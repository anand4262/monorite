# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already git-ignored.

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://www.monorite.com

# Contact form email delivery (server-side only, never exposed to the client).
# Example uses Resend (https://resend.com) — swap for your provider of choice.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@monorite.com
CONTACT_FROM_EMAIL=no-reply@monorite.com

# Powers the chat widget and homepage chat demo (/api/chat). Without this
# set, the chat UI still renders but replies with a clear "not configured"
# message instead of erroring. Get a key at https://platform.openai.com.
OPENAI_API_KEY=

# Search engine ownership verification (renders a meta tag; see README.md
# "Getting indexed" for where to get these). Optional — omitted from <head>
# entirely when unset.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Sends a Telegram notification (AI analysis + conversation snapshot) the
# first time a chat conversation becomes a real lead. See README.md
# "Lead notifications" for how to create the bot and get these values.
# Without both set, leads are still captured and stored, just not pushed
# anywhere — no error, silent no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Durably stores every contact form submission and chat lead (with a full
# transcript) in Postgres — see README.md "Database (Supabase)" for setup
# steps and the SQL to create the tables. Server-only: SUPABASE_SERVICE_ROLE_KEY
# has full read/write access and must never be exposed to the client, which
# is why this is NOT prefixed NEXT_PUBLIC_. Without both set, nothing is
# stored — no error, silent no-op (same as every other integration here).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=