# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is already git-ignored.

# Public site URL (used for metadata, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://www.monorite.com

# Contact form email delivery (server-side only, never exposed to the client).
# Example uses Resend (https://resend.com) — swap for your provider of choice.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@monorite.com
CONTACT_FROM_EMAIL=no-reply@monorite.com

# Simple shared secret used to sign/verify the honeypot + timing token.
# Generate with: openssl rand -hex 32
FORM_SECRET=change-me-in-production

# Powers the chat widget and homepage chat demo (/api/chat). Without this
# set, the chat UI still renders but replies with a clear "not configured"
# message instead of erroring. Get a key at https://platform.openai.com.
OPENAI_API_KEY=
